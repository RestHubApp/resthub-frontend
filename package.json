{
  "name": "resthub-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend de RestHub: sistema de información para restaurantes pequeños.",
  "type": "module",
  "imports": {
    "#jest/*": "./jest/*.ts"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "typecheck": "tsc -b",
    "knip": "knip --no-progress",
    "dup": "jscpd",
    "a11y": "node checks/accessibility/all.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:contract": "rm -rf pacts && jest --config jest.contract.config.js",
    "test:mutation": "stryker run",
    "generate:api": "openapi-typescript \"${VITE_API_URL:-http://localhost:8000}/api/v1/openapi.json\" -o src/api/schema.d.ts",
    "prepare": "husky",
    "test:e2e": "playwright test --project=coverage --project=desktop --project=mobile",
    "test:visual": "playwright test --project=visual-chromium-desktop --project=visual-chromium-mobile --project=visual-firefox-desktop --project=visual-firefox-mobile --project=visual-webkit-desktop --project=visual-webkit-mobile",
    "test:visual:ci": "playwright test --project=visual-chromium-desktop --project=visual-chromium-mobile",
    "test:visual:update": "bash scripts/visual-docker.sh",
    "e2e:inventory": "node e2e/inventory/generate.ts",
    "type-coverage": "type-coverage",
    "size": "size-limit",
    "carbon": "node scripts/carbon.ts",
    "carbon:browser": "node scripts/carbon.ts --mode browser",
    "doctor": "react-doctor . --verbose --no-score --no-supply-chain --blocking warning"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.1",
    "sienna-accessibility": "2.2.333",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@cspell/dict-css": "^4.1.2",
    "@cspell/dict-en_us": "^4.4.40",
    "@cspell/dict-html": "^4.0.16",
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-software-terms": "^5.4.7",
    "@cspell/dict-typescript": "^3.2.3",
    "@cspell/eslint-plugin": "^10.3.6",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@jest/globals": "^30.5.2",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tgwf/co2": "0.19.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-barrel-files": "^2.2.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "openapi-msw": "^2.1.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.63.0",
    "puppeteer-core": "25.12.0",
    "react-doctor": "0.9.17",
    "shadcn": "^4.21.0",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "type-coverage": "^2.30.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  },
  "typeCoverage": {
    "project": "tsconfig.app.json",
    "strict": true,
    "atLeast": 99.7,
    "ignoreFiles": [
      "src/api/schema.d.ts"
    ]
  },
  "size-limit": [
    {
      "name": "Bundle principal (armazón y router)",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "107.8 kB"
    },
    {
      "name": "Chunk de React",
      "path": "dist/assets/react-*.js",
      "gzip": true,
      "limit": "74.2 kB"
    },
    {
      "name": "Chunk de esquemas (zod)",
      "path": "dist/assets/schemas-*.js",
      "gzip": true,
      "limit": "40.9 kB"
    },
    {
      "name": "Chunk de accesibilidad (Sienna)",
      "path": "dist/assets/sienna-accessibility*.js",
      "gzip": true,
      "limit": "22.6 kB"
    },
    {
      "name": "Todo el JS",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "475 kB"
    }
  ]
}
